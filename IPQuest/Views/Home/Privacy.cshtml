@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="content-page">
    <div class="content-card">
        <h1>@ViewData["Title"]</h1>

        <p>
            IPQuest is an educational quiz application designed to teach
            Intellectual Property concepts. We respect your privacy and
            are committed to protecting your personal information.
        </p>

        <p>
            This application stores minimal data — only your player name
            and XP progress — in a local database. No personal information
            is shared with third parties.
        </p>

        <p>
            For questions about your data, please contact the application
            administrator.
        </p>
    </div>
</div>
