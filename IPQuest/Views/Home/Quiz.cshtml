@model List<IPQuest.Models.Question>

@{
    ViewData["Title"] = "Quiz";
    var topic = ViewBag.Topic as IPQuest.Models.Topic;
}

<div class="quiz-page">

    <div class="quiz-header">
        <span class="topics-label">IP QUEST</span>

        <h1>@topic?.Title Quiz</h1>

        <p>Choose the correct answer to continue your quest.</p>
    </div>

    <div class="quiz-progress">

        <div class="progress-info">
            <span id="progress-text">Question 1 of @Model.Count</span>
            <span id="progress-percent">0%</span>
        </div>

        <div class="progress-bar">
            <div class="progress-fill" id="progress-fill"></div>
        </div>

    </div>

    <div class="quiz-container">

        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="question-card quiz-question"
                 style="display: @(i == 0 ? "block" : "none");"
                 data-question="@i">

                <div class="question-number">
                    Question @(i + 1) of @Model.Count
                </div>

                <h2>@Model[i].Text</h2>

                <div class="answer-options">

                    @foreach (var option in Model[i].AnswerOptions)
                    {
                        <button type="button"
                                class="answer-option"
                                data-correct="@option.IsCorrect.ToString().ToLower()">
                            @option.Text
                        </button>
                    }

                </div>

                <div class="answer-feedback"></div>

                <button type="button"
                        class="next-button"
                        style="display: none;">
                    NEXT
                </button>

            </div>
        }

    </div>

</div>

<script>
    let currentQuestion = 0;
    let score = 0;

    const questions = document.querySelectorAll(".quiz-question");

    const progressText =
        document.getElementById("progress-text");

    const progressPercent =
        document.getElementById("progress-percent");

    const progressFill =
        document.getElementById("progress-fill");

    function updateProgress() {

        const progress =
            ((currentQuestion + 1) / questions.length) * 100;

        progressText.textContent =
            `Question ${currentQuestion + 1} of ${questions.length}`;

        progressPercent.textContent =
            `${Math.round(progress)}%`;

        progressFill.style.width =
            `${progress}%`;
    }

    updateProgress();

    questions.forEach((question) => {

        const options =
            question.querySelectorAll(".answer-option");

        const nextButton =
            question.querySelector(".next-button");

        const feedback =
            question.querySelector(".answer-feedback");

        options.forEach(option => {

            option.addEventListener("click", function () {

                options.forEach(btn => {
                    btn.disabled = true;
                });

                const isCorrect =
                    this.dataset.correct === "true";

                if (isCorrect) {

                    this.style.borderColor = "#22c55e";

                    score++;

                    feedback.textContent =
                        "Correct! +1 point";

                    feedback.style.color =
                        "#22c55e";

                } else {

                    this.style.borderColor = "#ef4444";

                    feedback.textContent =
                        "Not quite! The correct answer is shown in green.";

                    feedback.style.color =
                        "#ef4444";

                    options.forEach(btn => {

                        if (btn.dataset.correct === "true") {
                            btn.style.borderColor = "#22c55e";
                        }

                    });
                }

                nextButton.style.display = "block";
            });

        });

        nextButton.addEventListener("click", function () {

            question.style.display = "none";

            currentQuestion++;

            if (currentQuestion < questions.length) {

                questions[currentQuestion].style.display = "block";

                updateProgress();

            } else {

                showResult();

            }

        });

    });

    function showResult() {

        const quizContainer =
            document.querySelector(".quiz-container");

        let resultTitle = "";
        let resultMessage = "";

        if (score === questions.length) {

            resultTitle = "Excellent!";
            resultMessage = "Perfect score! You have mastered this topic.";

        } else if (score >= questions.length * 0.66) {

            resultTitle = "Great Job!";
            resultMessage = "You have a good understanding of this topic.";

        } else if (score > 0) {

            resultTitle = "Keep Practicing!";
            resultMessage = "You are getting there. Try the quiz again.";

        } else {

            resultTitle = "Keep Learning!";
            resultMessage = "Don't worry. Review the topic and try again.";

        }

        quizContainer.innerHTML = `
            <div class="question-card result-card">

                <div class="result-icon">🏆</div>

                <h2>${resultTitle}</h2>

                <p>${resultMessage}</p>

                <div class="score-label">
                    Your Score
                </div>

                <div class="score">
                    ${score} / ${questions.length}
                </div>

                <div class="result-actions">

                    <button type="button"
                            class="next-button"
                            onclick="location.reload()">
                        TRY AGAIN
                    </button>

                    <a href="/Home/Topics"
                       class="next-button">
                        BACK TO TOPICS
                    </a>

                </div>

            </div>
        `;
    }
</script>