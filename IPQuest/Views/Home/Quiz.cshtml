@model List<IPQuest.Models.Question>

@{
    ViewData["Title"] = "Quiz";
    var topic = ViewBag.Topic as IPQuest.Models.Topic;
}

<div class="quiz-page">

    <div class="quiz-header">
        <span class="badge">IP QUEST</span>

        <h1>@topic?.Title Quiz</h1>

        <p>Choose the correct answer to continue your quest.</p>
    </div>

    <div class="quiz-stats">

        <div class="quiz-stat">
            <span class="stat-icon">🎯</span>
            <div class="stat-info">
                <span class="stat-label">SCORE</span>
                <span class="stat-value" id="score-value">0</span>
            </div>
        </div>

        <div class="quiz-stat">
            <span class="stat-icon">⚡</span>
            <div class="stat-info">
                <span class="stat-label">XP</span>
                <span class="stat-value" id="xp-value">0</span>
            </div>
        </div>

    </div>

    <div class="quiz-progress">

        <div class="progress-info">
            <span id="progress-text">Question 1 of @Model.Count</span>
            <span id="progress-percent">0%</span>
        </div>

        <div class="progress-bar">
            <div class="progress-fill" id="progress-fill"></div>
        </div>

    </div>

    <div class="quiz-container">

        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="question-card quiz-question"
                 style="display: @(i == 0 ? "block" : "none");"
                 data-question="@i">

                <div class="question-number">
                    Question @(i + 1) of @Model.Count
                </div>

                <h2>@Model[i].Text</h2>

                <div class="answer-options">

                    @foreach (var option in Model[i].AnswerOptions)
                    {
                        <button type="button"
                                class="answer-option"
                                data-correct="@option.IsCorrect.ToString().ToLower()"
                                id="option-@option.Id">
                            @option.Text
                        </button>
                    }

                </div>

                <div class="answer-feedback"></div>

                <button type="button"
                        class="next-button"
                        style="display: none;">
                    NEXT →
                </button>

            </div>
        }

    </div>

</div>

<script>
    let currentQuestion = 0;
    let score = 0;
    let xp = 0;

    const XP_PER_CORRECT_ANSWER = 10;

    const questions =
        document.querySelectorAll(".quiz-question");

    const progressText =
        document.getElementById("progress-text");

    const progressPercent =
        document.getElementById("progress-percent");

    const progressFill =
        document.getElementById("progress-fill");

    const scoreValue =
        document.getElementById("score-value");

    const xpValue =
        document.getElementById("xp-value");

    function updateProgress() {

        const progress =
            ((currentQuestion + 1) / questions.length) * 100;

        progressText.textContent =
            `Question ${currentQuestion + 1} of ${questions.length}`;

        progressPercent.textContent =
            `${Math.round(progress)}%`;

        progressFill.style.width =
            `${progress}%`;
    }

    function updateStats() {

        scoreValue.textContent = score;
        xpValue.textContent = xp;
    }

    updateProgress();
    updateStats();

    questions.forEach((question) => {

        const options =
            question.querySelectorAll(".answer-option");

        const nextButton =
            question.querySelector(".next-button");

        const feedback =
            question.querySelector(".answer-feedback");

        options.forEach(option => {

            option.addEventListener("click", function () {

                // Disable all options
                options.forEach(btn => {
                    btn.disabled = true;
                });

                const isCorrect =
                    this.dataset.correct === "true";

                if (isCorrect) {

                    this.classList.add("correct");

                    score++;
                    xp += XP_PER_CORRECT_ANSWER;

                    feedback.textContent =
                        "✅ Correct! +10 XP";

                    feedback.classList.add("feedback-correct");

                    // Dim other options
                    options.forEach(btn => {
                        if (btn !== this) {
                            btn.classList.add("dimmed");
                        }
                    });

                    updateStats();

                } else {

                    this.classList.add("incorrect");

                    feedback.textContent =
                        "❌ Not quite! The correct answer is highlighted.";

                    feedback.classList.add("feedback-incorrect");

                    // Show correct answer and dim others
                    options.forEach(btn => {
                        if (btn.dataset.correct === "true") {
                            btn.classList.add("correct");
                        } else if (btn !== this) {
                            btn.classList.add("dimmed");
                        }
                    });
                }

                nextButton.style.display = "inline-flex";
            });

        });

        nextButton.addEventListener("click", function () {

            question.style.display = "none";

            currentQuestion++;

            if (currentQuestion < questions.length) {

                questions[currentQuestion].style.display = "block";

                updateProgress();

            } else {

                showResult();

            }

        });

    });

    function showResult() {

        const quizContainer =
            document.querySelector(".quiz-container");

        let resultTitle = "";
        let resultMessage = "";
        let resultEmoji = "";

        if (score === questions.length) {

            resultTitle = "Excellent!";
            resultMessage =
                "Perfect score! You've truly mastered this topic. You're an IP champion!";
            resultEmoji = "🏆";

        } else if (score >= questions.length * 0.66) {

            resultTitle = "Great Job!";
            resultMessage =
                "You have a strong understanding of this topic. Keep going!";
            resultEmoji = "🌟";

        } else if (score > 0) {

            resultTitle = "Keep Practicing!";
            resultMessage =
                "You're getting there. Review the topic and try the quiz again.";
            resultEmoji = "💪";

        } else {

            resultTitle = "Keep Learning!";
            resultMessage =
                "Don't worry — every expert was once a beginner. Review and try again!";
            resultEmoji = "📖";

        }

        quizContainer.innerHTML = `
            <div class="question-card result-card">

                <div class="result-icon">${resultEmoji}</div>

                <h2>${resultTitle}</h2>

                <p>${resultMessage}</p>

                <div class="score-label">
                    Your Score
                </div>

                <div class="score">
                    ${score} / ${questions.length}
                </div>

                <div class="score-label">
                    XP Earned
                </div>

                <div class="score">
                    ${xp} XP
                </div>

                <div class="result-actions">

                    <button type="button"
                            class="next-button"
                            onclick="location.reload()">
                        🔄 TRY AGAIN
                    </button>

                    <a href="/Home/Topics"
                       class="next-button">
                        📚 BACK TO TOPICS
                    </a>

                </div>

            </div>
        `;
    }
</script>