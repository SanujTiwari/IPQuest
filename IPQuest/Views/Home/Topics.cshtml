@model List<IPQuest.Models.Topic>

@{
    ViewData["Title"] = "IP Topics";
}

<div class="topics-page">

    <div class="topics-header">
        <span class="topics-label">YOUR QUEST BEGINS</span>

        <h1>Explore Intellectual Property</h1>

        <p>
            Choose a topic and discover how ideas, inventions, brands,
            and creative work are protected.
        </p>
    </div>

    <div class="topics-grid">

        @foreach (var topic in Model)
        {
            <div class="topic-card">

                <div class="topic-icon">
                    @topic.Icon
                </div>

                <div class="topic-content">
                    <h2>@topic.Title</h2>

                    <p>
                        @topic.Description
                    </p>

                    <a asp-controller="Home"
                       asp-action="Topic"
                       asp-route-id="@topic.Id"
                       class="topic-button">
                        START
                    </a>
                </div>

            </div>
        }

    </div>

</div>