<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="IPQuest — Learn Intellectual Property law through interactive quizzes. Explore Copyright, Trademark, Patent, and Trade Secrets." />
    <title>@ViewData["Title"] - IPQuest</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Particle Background -->
    <canvas id="particles-canvas"></canvas>

    <!-- Navigation -->
    <nav class="site-nav" id="site-nav">
        <a asp-controller="Home" asp-action="Index" class="nav-brand">IPQUEST</a>

        <button class="nav-toggle" aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index" id="nav-home">🏠 Home</a></li>
            <li><a asp-controller="Home" asp-action="Topics" id="nav-topics">📚 Topics</a></li>
            <li><a asp-controller="Home" asp-action="Player" id="nav-player">⭐ Player</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-content">
            <span class="footer-brand">IPQUEST</span>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Topics">Topics</a>
                <a asp-controller="Home" asp-action="Player">Player</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <span>&copy; 2026 IPQuest — Learn IP with Play</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
